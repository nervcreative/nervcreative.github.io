{
  "compilerOptions": {
    "target": "es5", // Or higher, depending on your browser support needs
    "lib": [
      "dom",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true, //  Can help with some type definition issues
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true, // Enable strict type checking
    "forceConsistentCasingInFileNames": true,
    "module": "esnext", // Or "commonjs" if you're not using ES modules
    "moduleResolution": "node",
    "resolveJsonModule": true, //  Useful for importing JSON files
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx", //  Crucial for React 17+
    "types": [
      "react",
      "react-dom"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}